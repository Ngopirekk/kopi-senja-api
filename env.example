# Salin file ini jadi ".env" untuk coba di komputer sendiri (opsional).
# Untuk deploy ke Render, isi dua nilai ini lewat menu "Environment" di
# dashboard Render — JANGAN upload file .env asli ke GitHub.

# Isi dari file kunci Service Account Firebase, dalam SATU BARIS (lihat README.md poin 2)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Sama seperti databaseURL di kode website kamu
FIREBASE_DATABASE_URL=https://kopi-senja-2ae43-default-rtdb.firebaseio.com
